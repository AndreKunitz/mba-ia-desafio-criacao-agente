{
  "info": {
    "name": "Residencial Aurora API",
    "description": "Chamadas da API do assistente. Rode primeiro 'Criar sessão': ela guarda o session_id. Quando uma resposta trouxer confirmacoes_pendentes, o id é guardado em confirmacao_id e a pasta 'Confirmações' já o usa. Troque 'apartamento' no corpo da sessão para testar outro morador.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "session_id",
      "value": ""
    },
    {
      "key": "confirmacao_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Sessão",
      "item": [
        {
          "name": "Criar sessão (apartamento 101)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/sessoes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "sessoes"
              ]
            },
            "description": "Define o apartamento da sessão uma única vez. Guarda session_id.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apartamento\": \"101\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set(\"session_id\", j.session_id);",
                  "pm.test(\"201 criada\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
